---
import Layout from '../../layouts/Layout.astro';
import projects from '../../data/projects.json';

type Project = (typeof projects)[number];
type ProjectWithCaseStudy = Project & {
	caseStudy: NonNullable<Project['caseStudy']>;
};

export function getStaticPaths() {
	return (projects as Project[]).filter((p): p is ProjectWithCaseStudy => Boolean(p.caseStudy)).map((p) => ({
		params: { slug: p.caseStudy.slug },
		props: { project: p },
	}));
}

interface Props {
	project: ProjectWithCaseStudy;
}

const { project } = Astro.props;
const { title, imageSrc, description, link, technologies, caseStudy } = project;
const pageTitle = `Case Study: ${title} · Ango Jeffrey`;
const pageDescription = `${title} — ${description.slice(0, 155)}${description.length > 155 ? '…' : ''}`;
const siteOrigin = Astro.site?.origin ?? "https://angojay.com";
const pageUrl = new URL(`/case-study/${caseStudy.slug}`, siteOrigin).href;
const projectImageUrl = new URL(imageSrc, siteOrigin).href;

const creativeWorkJsonLd = {
	"@context": "https://schema.org",
	"@type": "CreativeWork",
	name: title,
	description,
	url: pageUrl,
	image: projectImageUrl,
	author: {
		"@type": "Person",
		name: "Ango Jeffrey",
		url: siteOrigin,
	},
};
---

<Layout
	pageTitle={pageTitle}
	pageDescription={pageDescription}
	ogType="article"
	jsonLd={creativeWorkJsonLd}
>
	<article class="w-full container mx-auto px-4 sm:px-6 lg:px-10 py-10 lg:py-14">
		<div class="relative max-w-7xl mx-auto lg:grid lg:grid-cols-12 lg:gap-x-12 lg:gap-y-0">
			<!-- Left: title, image, summary — sticky on desktop (grid stretch gives this column full row height) -->
			<div class="lg:col-span-5 mb-10 lg:mb-0">
				<div class="lg:sticky lg:top-10 space-y-6">
					<a
						href="/#projects"
						class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-light-purple dark:text-zinc-400 dark:hover:text-light-purple transition-colors duration-300"
					>
						<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
							<path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						Back to projects
					</a>

					<header>
						<p class="text-sm uppercase tracking-wide text-light-purple font-medium mb-3">Case study</p>
						<h1 class="text-3xl sm:text-4xl font-bold text-ink dark:text-zinc-100 mb-6">{title}</h1>
						<a
							href={link}
							target="_blank"
							rel="noopener noreferrer"
							class="block w-full aspect-[16/10] rounded-lg overflow-hidden border border-ink/20 dark:border-night-border mb-6 transition-opacity hover:opacity-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light-purple focus-visible:ring-offset-2 dark:focus-visible:ring-offset-night"
							aria-label={`Open ${title} live site`}
						>
							<img src={imageSrc} alt="" class="w-full h-full object-cover" loading="eager" />
						</a>
						<p class="text-[15px] sm:text-base text-gray-500 dark:text-zinc-400 leading-relaxed">{description}</p>
						<a
							href={link}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 mt-6 text-sm font-medium text-light-purple hover:underline"
						>
							Visit live site
							<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<path
									d="M7 17L17 7M17 7H8M17 7V16"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</a>
					</header>
				</div>
			</div>

			<!-- Right: long-form sections -->
			<div class="lg:col-span-7 min-w-0 flex flex-col gap-14 lg:pt-0">
				<section class="case-study-section">
					<h2 class="text-xl font-bold text-ink dark:text-zinc-100 mb-1">The Challenge <span class="text-gray-500 dark:text-zinc-400 font-normal text-base">(The &ldquo;Why&rdquo;)</span></h2>
					<div class="mt-4 space-y-4 text-[15px] sm:text-base text-gray-600 dark:text-zinc-300 leading-relaxed whitespace-pre-line">
						{caseStudy.challenge}
					</div>
				</section>

				<section class="case-study-section">
					<h2 class="text-xl font-bold text-ink dark:text-zinc-100 mb-1">The Technical Strategy <span class="text-gray-500 dark:text-zinc-400 font-normal text-base">(The &ldquo;How&rdquo;)</span></h2>
					<div class="mt-4 space-y-4 text-[15px] sm:text-base text-gray-600 dark:text-zinc-300 leading-relaxed whitespace-pre-line">
						{caseStudy.technicalStrategy}
					</div>
				</section>

				<section class="case-study-section">
					<h2 class="text-xl font-bold text-ink dark:text-zinc-100 mb-1">The Key Features &amp; Contributions</h2>
					<ul class="mt-4 list-disc pl-5 space-y-3 text-[15px] sm:text-base text-gray-600 dark:text-zinc-300 leading-relaxed">
						{caseStudy.keyFeaturesAndContributions.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</section>

				<section class="case-study-section">
					<h2 class="text-xl font-bold text-ink dark:text-zinc-100 mb-1">The Impact <span class="text-gray-500 dark:text-zinc-400 font-normal text-base">(The &ldquo;Results&rdquo;)</span></h2>
					<div class="mt-4 space-y-4 text-[15px] sm:text-base text-gray-600 dark:text-zinc-300 leading-relaxed whitespace-pre-line">
						{caseStudy.impact}
					</div>
				</section>

				<section class="case-study-section">
					<h2 class="text-xl font-bold text-ink dark:text-zinc-100 mb-4">Technical Stack</h2>
					<div class="flex gap-y-2 gap-x-2 flex-wrap">
						{technologies.map((technology) => (
							<span
								class="rounded-full border border-ink bg-white dark:bg-ink px-3 py-1.5 text-xs sm:text-[13px] text-ink dark:border-white dark:text-white dark:hover:border-light-purple transition-colors duration-300"
							>
								{technology}
							</span>
						))}
					</div>
				</section>
			</div>
		</div>
	</article>
</Layout>
