---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/cards/ArticleCard";
import { fetchDevToArticles } from "../lib/devto";

const articles = await fetchDevToArticles();
---

<Layout
	pageTitle="Writing · Ango Jeffrey"
	pageDescription="Articles and technical writing by Ango Jeffrey — frontend engineering, performance, and web development."
>
	<main class="w-full container mx-auto px-4 sm:px-6 lg:px-10 py-10 lg:py-14">
		<div class="max-w-3xl mx-auto">
			<a
				href="/#articles"
				class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-light-purple dark:text-zinc-400 dark:hover:text-light-purple transition-colors duration-300 mb-10"
			>
				<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				Back to home
			</a>

			<header class="mb-10">
				<h1 class="text-3xl sm:text-4xl font-bold text-ink dark:text-zinc-100">Writing</h1>
			</header>

			{
				articles.length > 0 ? (
					<div class="flex flex-col gap-6">
						{articles.map((article) => (
							<ArticleCard {...article} />
						))}
					</div>
				) : (
					<p class="text-[15px] sm:text-base text-gray-500 dark:text-zinc-400">
						No articles could be loaded right now. Please try again later.
					</p>
				)
			}
		</div>
	</main>
</Layout>
