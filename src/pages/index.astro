---
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Layout from '../layouts/Layout.astro';
import ProjectCard from "../components/cards/ProjectCard";
import projects from "../data/projects.json";
import ArticleCard from "../components/cards/ArticleCard";
import { fetchDevToArticles } from "../lib/devto";

const articles = await fetchDevToArticles({ limit: 5 });
---

<Layout pageTitle="Ango Jeffrey · Senior Frontend Engineer">
<div class="w-full container mx-auto px-4 sm:px-6 lg:px-10 ">
<div class="w-full flex flex-col lg:flex-row gap-10">
	<Hero />
	<div class="w-full lg:w-[50%]">
		<About />
		<section
		id="projects"
		class="w-full flex flex-col gap-10 py-10">
		<h4 class="flex lg:hidden uppercase text-sm font-medium text-ink dark:text-zinc-100">
			Projects
		  </h4>
			{projects.map((project) => (
			  <ProjectCard
				title={project.title}
				imageSrc={project.imageSrc}
				description={project.description}
				link={project.link}
				caseStudy={project.caseStudy}
			  />
			))}
		</section>
		<section
		id="articles"
		class="w-full flex flex-col gap-10 py-10">
		<h4 class="flex lg:hidden uppercase text-sm font-medium text-ink dark:text-zinc-100">
			Articles
		</h4>
			{articles.map((article) => (
			  <ArticleCard
				{...article}
			  />
			))}
			<div class="flex w-full justify-center pt-2">
				<a
					href="/blogs"
					class="text-sm font-medium text-light-purple hover:underline"
				>
					View more
				</a>
			</div>
		</section>
	</div>

</div>
</div>
</Layout>
