---
import Footer from "../components/sections/Footer.astro";
import Header from "../components/sections/Header";
import ThemePicker from "../components/ThemePicker";
import "../styles/global.css";

interface Props {
	pageTitle?: string;
	pageDescription?: string;
	ogType?: "website" | "article";
	/** Extra JSON-LD objects (e.g. CreativeWork on case studies), merged after Person */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const SITE_ORIGIN = Astro.site?.origin ?? "https://angojay.com";
const DEFAULT_DESCRIPTION =
	"Ango Jeffrey is a Senior Frontend Engineer with a passion for building scalable, user friendly and elegant web and mobile applications.";

const {
	pageTitle = "Ango Jeffrey",
	pageDescription = DEFAULT_DESCRIPTION,
	ogType = "website",
	jsonLd,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, SITE_ORIGIN).href;
const ogImageUrl = new URL("/Ango_Jeffrey_Profile_2.jpg", SITE_ORIGIN).href;
const ogImageAlt = "Ango Jeffrey";

const personJsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Ango Jeffrey",
	url: SITE_ORIGIN,
	image: ogImageUrl,
	jobTitle: "Senior Frontend Engineer",
	sameAs: ["https://dev.to/angojay", "https://github.com/Ango-Jay"],
};

const extraJsonLd = jsonLd
	? Array.isArray(jsonLd)
		? jsonLd
		: [jsonLd]
	: [];
const jsonLdBlocks = [personJsonLd, ...extraJsonLd];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#090040" />
		<meta name="description" content={pageDescription} />
		<title>{pageTitle}</title>
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="Ango Jeffrey" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={ogImageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImageUrl} />

		{
			jsonLdBlocks.map((block) => (
				<script type="application/ld+json" set:html={JSON.stringify(block)} />
			))
		}
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem("theme");
					if (stored === "system") {
						localStorage.removeItem("theme");
						stored = null;
					}
					var dark =
						stored === "dark"
							? true
							: stored === "light"
								? false
								: window.matchMedia("(prefers-color-scheme: dark)").matches;
					var root = document.documentElement;
					root.dataset.theme = dark ? "dark" : "light";
					root.classList.toggle("dark", dark);
				} catch (e) {
					var r = document.documentElement;
					r.dataset.theme = "light";
					r.classList.remove("dark");
				}
			})();
		</script>
	</head>
	<body class="min-h-screen bg-surface text-ink antialiased transition-colors duration-200 dark:bg-night dark:text-zinc-100">
		<ThemePicker client:load />
		<Header client:load />
		<slot />
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
