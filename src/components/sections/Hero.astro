---
import ContentList from "../ContentList";
import Contact from "../Contact";
import { Image } from "astro:assets";
---

<div class="w-full lg:w-[50%] flex flex-col pt-[72px] lg:h-screen lg:sticky lg:top-0">
<div class="w-full flex">
    <div
      class="group relative h-[180px] w-[180px] shrink-0 [perspective:720px]"
    >
      <div
        class="relative block h-full w-full rounded-full transition-transform duration-500 ease-in-out [transform-style:preserve-3d] motion-reduce:transition-none lg:group-hover:[transform:rotateY(180deg)] motion-reduce:lg:group-hover:[transform:none]"
      >
        <div
          class="absolute inset-0 overflow-hidden rounded-full border border-ink bg-ink p-1 [backface-visibility:hidden] dark:border-white"
        >
          <Image
            src="/Ango_Jeffrey_Profile_2.jpg"
            class="h-full w-full rounded-full object-top object-cover"
            alt="Ango Jeffrey"
            width={72}
            height={72}
          />
        </div>
        <div
          class="absolute inset-0 overflow-hidden rounded-full border border-light-purple bg-white p-1 [backface-visibility:hidden] [transform:rotateY(180deg)] dark:bg-ink"
        >
        <Image
        src="/Ango_Jeffrey_Profile_2.jpg"
        class="h-full w-full rounded-full object-top object-cover"
        alt="Ango Jeffrey"
        width={72}
        height={72}
      />
        </div>
      </div>
    </div>
</div>
    <h2 class="text-3xl md:text-4xl lg:text-6xl xl:text-8xl font-bold mb-4 text-ink dark:text-zinc-50">
        Ango Jeffrey
    </h2>
    <h4 class="text-lg sm:text-xl lg:text-2xl font-medium mb-4 text-ink/90 dark:text-zinc-200">
        Senior Frontend Engineer
    </h4>
    <p class="text-sm lg:text-base mb-10 text-gray-600 dark:text-zinc-400">
        Building scalable, user friendly and elegant web and mobile applications.
    </p>
    <Contact />
    <ContentList
    client:load
    />
</div>